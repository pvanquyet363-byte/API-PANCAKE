    "/api/Webhook": {
      "post": {
        "tags": [
          "Webhook"
        ],
        "summary": "Endpoint webhook chung để nhận tất cả sự kiện từ PanCake (Order, Customer, v.v.)",
        "description": "Endpoint CHUNG này có thể nhận mọi loại webhook từ PanCake:\r\n- Đơn hàng (type: \"orders\")\r\n- Khách hàng (type: \"customers\")\r\n- Các loại khác trong tương lai\r\n\r\nPanCake sẽ tự động gửi field \"type\" trong webhook để phân biệt loại sự kiện.\r\n\r\nĐỂ SỬ DỤNG:\r\n1. Đăng ký URL này trong PanCake: https://your-domain.com/api/webhook\r\n2. PanCake sẽ gửi tất cả webhook về URL này\r\n3. API sẽ tự động phân loại và xử lý dựa trên field \"type\"",
        "requestBody": {
          "description": "Dữ liệu webhook từ PanCake",
          "content": {
            "application/json": {
              "schema": { }
            },
            "text/json": {
              "schema": { }
            },
            "application/*+json": {
              "schema": { }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
