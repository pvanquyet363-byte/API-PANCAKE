    "/api/Webhook/customer": {
      "post": {
        "tags": [
          "Webhook"
        ],
        "summary": "Nhận webhook từ PanCake khi có khách hàng mới hoặc thay đổi",
        "description": "Endpoint này sẽ nhận các sự kiện từ PanCake như:\r\n- customer.created: Khách hàng mới được tạo\r\n- customer.updated: Khách hàng được cập nhật\r\n- customer.deleted: Khách hàng bị xóa\r\n\r\nĐể sử dụng:\r\n1. Đăng ký URL webhook này trong PanCake: https://your-domain.com/api/webhook/customer\r\n2. PanCake sẽ tự động gửi POST request đến endpoint này khi có sự kiện\r\n\r\nVí dụ webhook data từ PanCake:\r\n\r\n    POST /api/webhook/customer\r\n    {\r\n        \"id\": 123456,\r\n        \"event_type\": \"customer.created\",\r\n        \"shop_id\": 789,\r\n        \"customer_code\": \"KH-000123\",\r\n        \"name\": \"Nguyễn Văn A\",\r\n        \"phone_number\": \"0901234567\",\r\n        \"email\": \"customer@example.com\",\r\n        \"address\": \"123 Đường ABC\",\r\n        \"province_name\": \"TP. Hồ Chí Minh\",\r\n        \"district_name\": \"Quận 1\",\r\n        \"commune_name\": \"Phường Bến Nghé\",\r\n        \"customer_level_name\": \"VIP\",\r\n        \"point\": 1000,\r\n        \"total_spent\": 5000000,\r\n        \"gender\": \"male\",\r\n        \"date_of_birth\": \"1990-01-01\",\r\n        \"inserted_at\": \"2024-03-10T10:30:00Z\",\r\n        \"updated_at\": \"2024-03-10T10:30:00Z\",\r\n        \"timestamp\": 1710000000,\r\n        \"signature\": \"abc123...\"\r\n    }",
        "requestBody": {
          "description": "Dữ liệu webhook từ PanCake",
          "content": {
            "application/json": {
              "schema": { }
            },
            "text/json": {
              "schema": { }
            },
            "application/*+json": {
              "schema": { }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
