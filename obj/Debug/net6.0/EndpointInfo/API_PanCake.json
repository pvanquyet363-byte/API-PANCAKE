{
  "openapi": "3.0.1",
  "info": {
    "title": "PanCake Product API",
    "description": "API để tạo và cập nhật sản phẩm trên PanCake POS",
    "version": "v1"
  },
  "paths": {
    "/api/InventorySync/background-service-status": {
      "get": {
        "tags": [
          "InventorySync"
        ],
        "summary": "🔍 Kiểm tra trạng thái Background Service",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/InventorySync/sync": {
      "post": {
        "tags": [
          "InventorySync"
        ],
        "summary": "Đồng bộ tồn kho từ ERP lên PanCake\r\nWarehouse IDs sẽ được tự động lấy từ thông tin sản phẩm trên PanCake",
        "description": "Sample request:\r\n\r\n    POST /api/InventorySync/sync\r\n    {\r\n        \"shopId\": 1635971586,\r\n        \"maVt\": \"TEST323\",\r\n        \"remainQuantity\": 50\r\n    }\r\n    \r\nAPI sẽ:\r\n1. Tìm product variation trên PanCake theo ma_vt (search API)\r\n2. Tự động lấy tất cả warehouse_id từ thông tin sản phẩm\r\n3. Cập nhật số lượng tồn cho tất cả các kho với giá trị remainQuantity",
        "requestBody": {
          "description": "Thông tin đồng bộ (ShopId, MaVt, RemainQuantity)",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventorySyncRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InventorySyncRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InventorySyncRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/InventorySyncResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventorySyncResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventorySyncResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/api/InventorySync/search-product": {
      "get": {
        "tags": [
          "InventorySync"
        ],
        "summary": "Tìm kiếm thông tin product variation theo mã vật tư",
        "parameters": [
          {
            "name": "shopId",
            "in": "query",
            "description": "Shop ID trên PanCake",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "maVt",
            "in": "query",
            "description": "Mã vật tư",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProductVariationInfo"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductVariationInfo"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductVariationInfo"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
