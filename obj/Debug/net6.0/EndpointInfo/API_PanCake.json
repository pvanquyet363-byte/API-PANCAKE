    "/api/Product/create": {
      "post": {
        "tags": [
          "Product"
        ],
        "summary": "Tạo sản phẩm mới",
        "description": "Các trường BẮT BUỘC:\r\n- Name (string): Tên sản phẩm\r\n- Weight (int): Trọng lượng sản phẩm\r\n\r\nLƯU Ý: Chỉ cần truyền API Key, hệ thống sẽ tự động lấy Shop ID\r\n\r\nVí dụ request:\r\n\r\n    POST /api/Product/create?apiKey=your_api_key\r\n    {\r\n        \"name\": \"Áo sơ mi nam\",\r\n        \"weight\": 100,\r\n        \"categoryIds\": [1290021044, 201250699],\r\n        \"noteProduct\": \"Ghi chú sản phẩm\",\r\n        \"productAttributes\": [\r\n            {\r\n                \"name\": \"Màu\",\r\n                \"values\": [\"Đen\", \"Trắng\", \"Đỏ\"]\r\n            },\r\n            {\r\n                \"name\": \"Size\",\r\n                \"values\": [\"S\", \"M\", \"L\"]\r\n            }\r\n        ],\r\n        \"tags\": [193, 51],\r\n        \"variations\": [\r\n            {\r\n                \"fields\": [\r\n                    {\"name\": \"Màu\", \"value\": \"Trắng\"},\r\n                    {\"name\": \"Size\", \"value\": \"M\"}\r\n                ],\r\n                \"images\": [\"https://example.com/image.jpg\"],\r\n                \"lastImportedPrice\": 30000,\r\n                \"retailPrice\": 140000,\r\n                \"barcode\": \"BARCODE123\",\r\n                \"customId\": \"VCUSTOMID\"\r\n            }\r\n        ],\r\n        \"customId\": \"PCUSTOMID\",\r\n        \"isPublished\": true\r\n    }",
        "parameters": [
          {
            "name": "apiKey",
            "in": "query",
            "description": "API Key để authenticate với PanCake (tự động lấy Shop ID)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Thông tin sản phẩm cần tạo",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectPanCakeApiResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectPanCakeApiResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectPanCakeApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Product/update": {
      "put": {
        "tags": [
          "Product"
        ],
        "summary": "Cập nhật sản phẩm",
        "description": "LƯU Ý: \r\n- Chỉ cần truyền API Key, hệ thống sẽ tự động lấy Shop ID\r\n- Với endpoint Update thì KHÔNG cần truyền đầy đủ tất cả trường\r\n- Chỉ truyền các trường bạn muốn cập nhật\r\n\r\nVí dụ request:\r\n\r\n    PUT /api/Product/update?productId=3487e126-b0d9-4dae-89a9-ee60bef2f4e9&apiKey=your_api_key\r\n    {\r\n        \"name\": \"Áo sơ mi nam - Updated\",\r\n        \"retailPrice\": 150000,\r\n        \"variations\": [\r\n            {\r\n                \"id\": \"3c3aca82-030e-4708-a75b-b2eaf538a2f5\",\r\n                \"retailPrice\": 150000\r\n            }\r\n        ]\r\n    }",
        "parameters": [
          {
            "name": "productId",
            "in": "query",
            "description": "ID của sản phẩm cần cập nhật",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "apiKey",
            "in": "query",
            "description": "API Key để authenticate với PanCake (tự động lấy Shop ID)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Thông tin sản phẩm cần cập nhật (chỉ truyền các trường cần thay đổi)",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectPanCakeApiResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectPanCakeApiResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectPanCakeApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
